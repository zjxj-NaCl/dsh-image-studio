{
  "name": "dsh-image-studio",
  "version": "0.11.5",
  "description": "Image generation studio for DeepSeek Harness: a gallery and a workbench for text-to-image, image-to-image and local ComfyUI workflows, calling OpenAI-compatible, Google, Seedream, DashScope, xAI and Zhipu image APIs directly while the host keeps every credential.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check:build": "node build.mjs --check",
    "test": "node build.mjs --check && node test-image-api.mjs && node test-studio-model.mjs && node test-client.mjs && node test-auth.mjs && node test-comfy.mjs && node test-host.mjs && node test-tool.mjs && node test-bridge.mjs && node test-bridge-route.mjs && node test-package.mjs",
    "prepack": "node build.mjs"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/image-api.js",
    "lib/comfy.js",
    "lib/tool.js",
    "lib/client.js",
    "lib/conversation-host.js",
    "lib/bridge.js",
    "src",
    "build.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "INSTALL.md",
    "CHANGELOG.md",
    "LICENSE",
    "test-*.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "react": ">=18.2.0 <19"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": {
    "name": "zjxj-NaCl"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjxj-NaCl/dsh-image-studio.git"
  },
  "homepage": "https://github.com/zjxj-NaCl/dsh-image-studio#readme",
  "bugs": {
    "url": "https://github.com/zjxj-NaCl/dsh-image-studio/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "image-generation",
    "image-studio",
    "text2img",
    "img2img",
    "comfyui",
    "openai-compatible",
    "gemini",
    "seedream",
    "dashscope",
    "xai",
    "zhipu"
  ]
}
